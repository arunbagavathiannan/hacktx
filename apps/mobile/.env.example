# Copy to apps/mobile/.env (gitignored) and fill in from the Huddle project:
# Supabase Dashboard → Project Settings → API.
# Only the anon key goes here. The service-role, Muse Spark, SerpAPI and Places keys
# live in Supabase secrets (npx supabase secrets set ...).
EXPO_PUBLIC_SUPABASE_URL=https://<huddle-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
